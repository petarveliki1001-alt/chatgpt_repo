<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.37</Version>
    <AssemblyName>MemoirsReader</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <ProjectReference Include="../NativeSpeech/NativeSpeech.csproj" />
    <None Include="../NativeSpeech/models.json" Link="models.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><None Remove="*.py" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../PocketWorker/PocketWorker.csproj" ReferenceOutputAssembly="false" Private="false" /></ItemGroup>
  <Target Name="CopyPocketWorker" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup><PocketFiles Include="../PocketWorker/bin/$(Configuration)/net8.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PocketFiles)" DestinationFiles="@(PocketFiles->'$(OutDir)SpeechWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
